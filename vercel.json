{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "installCommand": "npm install && corepack pnpm --dir landing install --frozen-lockfile",
  "buildCommand": "corepack pnpm --dir landing build",
  "outputDirectory": "landing/out",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  }
}
