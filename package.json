{
  "name": "shadrox",
  "private": true,
  "version": "0.0.8",
  "description": "Native desktop AI engineering workspace with BYOK and live project preview.",
  "author": "Sourav Maurya",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:landing": "npm --prefix landing run dev",
    "dev:desktop": "concurrently -k \"npm:dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "vite build",
    "build:desktop": "node scripts/package-desktop.js",
    "dist:win": "node scripts/package-desktop.js --win nsis",
    "release:win": "node scripts/package-desktop.js --win nsis --publish always",
    "dist:mac": "node scripts/package-desktop.js --mac dmg",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "benchmark": "node scripts/run-benchmark.mjs",
    "verify:proofs": "node scripts/verify-proofs.mjs",
    "lint": "node node_modules/typescript-legacy/bin/tsc --noEmit",
    "typecheck": "node node_modules/typescript-legacy/bin/tsc --noEmit"
  },
  "dependencies": {
    "bytenode": "^2.1.0",
    "chokidar": "^4.0.3",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "node-pty": "^1.1.0",
    "tree-kill": "^1.2.2",
    "tsx": "^4.21.0",
    "typescript-legacy": "npm:typescript@^5.9.3"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.2.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.18.1",
    "esbuild": "^0.28.2",
    "esbuild-wasm": "^0.28.2",
    "javascript-obfuscator": "^4.2.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.shadrox.desktop",
    "productName": "ShadRox",
    "icon": "assets/icon.png",
    "artifactName": "ShadRox-v${version}-Setup.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/@esbuild/**/*"
    ],
    "directories": {
      "output": "dist_desktop"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iamsouravmourya-jpg",
        "repo": "ShadRox",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "api/**/*",
      "assets/**/*",
      "src/lib/**/*",
      "server.ts",
      "package.json",
      "!node_modules/.cache/**",
      "!**/.next/**",
      "!dist_desktop/**",
      "!**/__tests__/**",
      "!**/test/**",
      "!**/tests/**",
      "!**/*.test.*",
      "!**/*.spec.*"
    ],
    "extraResources": [
      {
        "from": "node_modules/typescript-legacy/lib",
        "to": "ts-libs",
        "filter": [
          "**/*.d.ts"
        ]
      },
      {
        "from": "electron/shell-integration",
        "to": "shell-integration"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
