{
  "name": "shadrox",
  "private": true,
  "version": "0.2.0",
  "description": "Native desktop AI engineering workspace with BYOK and live project preview.",
  "author": "Sourav Maurya",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:landing": "npm --prefix landing run dev",
    "dev:desktop": "concurrently -k \"npm:dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "vite build",
    "build:desktop": "node scripts/package-desktop.js",
    "dist:win": "node scripts/package-desktop.js --win nsis",
    "dist:mac": "node scripts/package-desktop.js --mac dmg",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "test": "node --import tsx --test electron/workspace.test.cjs electron/preview.test.mjs electron/preview-runtime.test.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "node-pty": "^1.1.0",
    "tree-kill": "^1.2.2",
    "tree-sitter-wasms": "^0.1.13",
    "tsx": "^4.21.0",
    "web-tree-sitter": "^0.25.10"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.2.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild-wasm": "^0.28.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.shadrox.desktop",
    "productName": "ShadRox",
    "asar": true,
    "asarUnpack": [
      "node_modules/@esbuild/**/*"
    ],
    "directories": {
      "output": "dist_desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "api/**/*",
      "src/lib/providers.ts",
      "server.ts",
      "package.json",
      "!node_modules/.cache/**",
      "!**/.next/**",
      "!dist_desktop/**",
      "!**/__tests__/**",
      "!**/test/**",
      "!**/tests/**",
      "!**/*.test.*",
      "!**/*.spec.*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
